# Pantopus iOS — Fastfile
# https://docs.fastlane.tools

default_platform(:ios)

# Build an App Store Connect API key from the secrets the CI workflow writes
# into .env (APP_STORE_CONNECT_KEY_ID / ISSUER_ID / KEY_CONTENT). Returns nil
# when unset so local `make build` style runs don't require credentials.
# KEY_CONTENT is the base64-encoded contents of the .p8 file.
def appstore_api_key
  key_id = ENV["APP_STORE_CONNECT_KEY_ID"].to_s
  issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"].to_s
  key_content = ENV["APP_STORE_CONNECT_KEY_CONTENT"].to_s
  return nil if key_id.empty? || issuer_id.empty? || key_content.empty?

  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_content: key_content,
    is_key_content_base64: true,
    in_house: false
  )
end

# Every target in the App Store archive and its bundle id. The widget
# extension ships inside the app, so it needs its own App Store profile.
APP_STORE_TARGETS = {
  "Pantopus" => "app.pantopus.ios",
  "PantopusWidgets" => "app.pantopus.ios.widgets"
}.freeze

def app_store_profile_name(identifier)
  "match AppStore #{identifier}"
end

def app_store_export_options
  { provisioningProfiles: APP_STORE_TARGETS.values.to_h { |id| [id, app_store_profile_name(id)] } }
end

# App Store Connect takes one to three period-separated integers.
APP_STORE_VERSION = /\d+(?:\.\d+){0,2}/

# A run on the ios-v1.2.3 tag names the build 1.2.3, so a release never edits
# project.yml's MARKETING_VERSION. Any other run (a branch, a local `make beta`)
# gets nil and keeps project.yml's value.
def tag_marketing_version
  return nil unless ENV["GITHUB_REF_TYPE"] == "tag"

  tag = ENV["GITHUB_REF_NAME"].to_s
  tag[/\Aios-v(#{APP_STORE_VERSION})\z/, 1] ||
    UI.user_error!("A tag build needs a tag like ios-v1.2.3 (up to three numbers), not '#{tag}'")
end

# The version `release` submits: `fastlane release version:1.2.3`, else the
# ios-v1.2.3 tag of a CI run. There is no project.yml fallback, because tags
# name the TestFlight builds.
def release_version(option)
  version = option.nil? ? tag_marketing_version : option.to_s
  UI.user_error!("Say which version to submit: `fastlane release version:1.2.3` or `make release VERSION=1.2.3`") if version.nil?
  UI.user_error!("A version has up to three numbers, like 1.2.3, not '#{version}'") unless version.match?(/\A#{APP_STORE_VERSION}\z/)

  version
end

platform :ios do
  before_all do
    # Materialize Config/Secrets.xcconfig from .env so the per-configuration
    # xcconfig `#include? "Secrets.xcconfig"` resolves the real Stripe key
    # (and Sentry DSN). Without this, Release builds fall back to the
    # committed pk_live_REPLACE_ME placeholder. The CI workflow writes .env
    # from repository secrets before this lane runs. `make bootstrap` does that,
    # then runs XcodeGen (fastlane has no xcodegen action).
    app_root = File.expand_path("..", __dir__)
    sh("make", "-C", app_root, "bootstrap")
  end

  desc "Run unit + UI tests on simulator"
  lane :test do
    run_tests(
      project: "Pantopus.xcodeproj",
      scheme: "Pantopus",
      devices: ["iPhone 15"],
      clean: true
    )
  end

  desc "Build a signed Release archive without uploading (CI dry run / verification)"
  lane :build_release do
    setup_ci if is_ci
    api_key = appstore_api_key
    app_store_signing(api_key: api_key)

    build_app(
      project: "Pantopus.xcodeproj",
      scheme: "Pantopus",
      configuration: "Release",
      export_method: "app-store",
      export_options: app_store_export_options,
      clean: true
    )
    UI.success("✓ Signed Release archive built (no upload). Verify it points at api.pantopus.com with the Stripe key decision D4 calls for (pk_test_ during the pilot, pk_live_ after).")
  end

  desc "Build and upload to TestFlight (via match for signing)"
  lane :beta do
    version = tag_marketing_version
    setup_ci if is_ci
    api_key = appstore_api_key
    app_store_signing(api_key: api_key)

    # Without `version:` this is TestFlight's newest upload of any version, so
    # build numbers keep rising when a tag starts a new version.
    build_number = latest_testflight_build_number(initial_build_number: 0, api_key: api_key) + 1
    increment_build_number(build_number: build_number)
    UI.message("Version #{version || 'from project.yml'}, build #{build_number}")

    build_app(
      project: "Pantopus.xcodeproj",
      scheme: "Pantopus",
      configuration: "Release",
      export_method: "app-store",
      export_options: app_store_export_options,
      # Sets CFBundleShortVersionString for the app and its widget extension.
      xcargs: ("MARKETING_VERSION=#{version}" if version),
      clean: true
    )

    upload_dsyms_to_sentry

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      changelog: last_git_commit[:message]
    )
  end

  # Like Android's `release`, this promotes a build that is already uploaded
  # instead of rebuilding, so nothing here signs or builds.
  desc "Submit TestFlight's newest build of a version for App Store review, with metadata + screenshots (release version:1.2.3)"
  lane :release do |options|
    version = release_version(options[:version])
    api_key = appstore_api_key

    # TestFlight's newest upload of this version, so run this once that build
    # has finished processing. initial_build_number 0 comes back when there is
    # no upload of the version.
    build_number = latest_testflight_build_number(version: version, initial_build_number: 0, api_key: api_key)
    UI.user_error!("TestFlight has no build of #{version}. Push the ios-v#{version} tag first, so `beta` uploads one.") if build_number.to_s == "0"
    UI.message("Submitting version #{version}, build #{build_number}")

    # Push every text file under fastlane/metadata/<locale>/ + the
    # screenshots under fastlane/screenshots/ before submitting. deliver
    # creates or renames the editable App Store version to app_version and
    # selects the uploaded build instead of uploading a binary.
    upload_to_app_store(
      api_key: api_key,
      app_version: version,
      build_number: build_number.to_s,
      skip_binary_upload: true,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      precheck_include_in_app_purchases: false,
      skip_metadata: false,
      skip_screenshots: false
    )
  end

  desc "Capture App Store screenshots for the 6 hero screens × 3 devices"
  lane :screenshots do
    capture_screenshots(
      project: "Pantopus.xcodeproj",
      scheme: "PantopusUITests",
      output_directory: "./fastlane/screenshots",
      clear_previous_screenshots: true,
      override_status_bar: true,
      stop_after_first_error: false
    )
  end

  # App Store signing for every target. match fetches both profiles (run it
  # once locally without readonly to create them), then each target switches
  # from the project's automatic signing, which can't provision on a CI runner
  # without an Apple account, to its match profile.
  private_lane :app_store_signing do |options|
    match(
      type: "appstore",
      app_identifier: APP_STORE_TARGETS.values,
      readonly: is_ci,
      api_key: options[:api_key]
    )
    APP_STORE_TARGETS.each do |target, identifier|
      update_code_signing_settings(
        path: "Pantopus.xcodeproj",
        use_automatic_signing: false,
        targets: [target],
        build_configurations: ["Release"],
        team_id: ENV["APPLE_TEAM_ID"],
        code_sign_identity: "Apple Distribution",
        profile_name: app_store_profile_name(identifier)
      )
    end
  end

  # Upload the freshly-built dSYMs to Sentry so release crashes symbolicate
  # to real source lines. Bitcode is OFF (project.yml: ENABLE_BITCODE NO), so
  # gym's local dSYMs are final — no App Store Connect re-download needed.
  #
  # Gated on Sentry env: a no-op (with a notice) when the credentials are not
  # present, so dev / CI lanes without secrets still pass.
  desc "Upload build dSYMs to Sentry for release symbolication"
  private_lane :upload_dsyms_to_sentry do
    auth_token = ENV["SENTRY_AUTH_TOKEN"].to_s.strip
    org = ENV["SENTRY_ORG"].to_s.strip
    project = ENV["SENTRY_PROJECT"].to_s.strip

    if [auth_token, org, project].any?(&:empty?)
      UI.important("Sentry dSYM upload skipped — set SENTRY_AUTH_TOKEN, SENTRY_ORG and SENTRY_PROJECT to enable.")
      next
    end

    # build_app sets this only when it zipped the archive's dSYMs. Without a
    # path, the plugin would search the whole app folder instead.
    dsym_path = lane_context[SharedValues::DSYM_OUTPUT_PATH]
    UI.user_error!("build_app left no dSYM zip to upload to Sentry") if dsym_path.to_s.empty?

    # fastlane-plugin-sentry 2.0 replaced sentry_upload_dsym with this action.
    sentry_debug_files_upload(
      auth_token: auth_token,
      org_slug: org,
      project_slug: project,
      path: [dsym_path]
    )
  end

  error do |lane, exception|
    UI.error("Lane #{lane} failed: #{exception.message}")
  end
end
