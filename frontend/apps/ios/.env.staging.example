# Copy to .env.staging and fill with the designated staging public configuration.
# Run `make bootstrap-staging`, then select the Pantopus (Staging) scheme.
# This file never configures the backend's APNs credentials.
PANTOPUS_API_BASE_URL=https://REPLACE_ME.invalid
PANTOPUS_SOCKET_URL=https://REPLACE_ME.invalid
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
SENTRY_DSN=
POSTHOG_API_KEY=

# TestFlight/distribution signing uses production APNs. For a local development
# signed device build, set development and match backend APNS_PRODUCTION=false.
# Verify the signed app's entitlement before sending; the scheme is not proof.
APS_ENVIRONMENT=production
