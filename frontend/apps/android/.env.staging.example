# Copy to .env.staging; select with -Ppantopus.envFile=.env.staging.
# Use assembleDebug/installDebug for physical notification testing.
PANTOPUS_API_BASE_URL=https://REPLACE_ME.invalid
PANTOPUS_SOCKET_URL=https://REPLACE_ME.invalid
PANTOPUS_ENV=staging
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
MAPS_API_KEY=
SENTRY_DSN=
POSTHOG_API_KEY=

# Download the staging Firebase app config for app.pantopus.android.debug into
# app/src/debug/google-services.json. The FCM server must target that project.
# Never put a Firebase service-account private key in this native env file.
