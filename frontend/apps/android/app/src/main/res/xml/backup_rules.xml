<?xml version="1.0" encoding="utf-8"?>
<!-- https://developer.android.com/guide/topics/data/autobackup -->
<full-backup-content>
    <!-- Schedule recovery uses this device's Keystore; it cannot travel with a backup. -->
    <exclude domain="sharedpref" path="private_home_task_recurrence_v1.xml" />
    <exclude domain="sharedpref" path="private_home_task_gig_v1.xml" />
    <!-- Never back up auth tokens. The legacy v1 DataStore path is retained
         until the one-shot migration in TokenStorage drains and clears it. -->
    <exclude domain="sharedpref" path="secure_auth_tokens.xml" />
    <exclude domain="file" path="datastore/auth_tokens.preferences_pb" />
    <!-- Persistent login: the per-install device identity (deviceId /
         installId, data/auth/DeviceIdentity.kt) must never travel with a
         backup — a restored app on another phone must present as a NEW
         device, not impersonate this one. -->
    <exclude domain="sharedpref" path="device_identity.xml" />
    <!-- App-lock preference (core/security/AppLockManager.kt) lives in an
         EncryptedSharedPreferences file whose Keystore master key never
         leaves this device; a restored copy would be undecryptable. -->
    <exclude domain="sharedpref" path="app_lock_prefs_secure.xml" />
</full-backup-content>
