<?xml version="1.0" encoding="utf-8"?>
<!-- The cache folders the app hands to other apps through FileProvider content:// URIs. Only these:
     the rest of the cache (the image cache, queued crash reports, documents being read) stays private. -->
<paths>
    <!-- Photos the camera app takes for a chat, a task post, a post or a reading (ChatMediaUrl, GigCameraPhotos,
         PostCameraPhotos, ReadingSources). -->
    <cache-path
        name="chat_camera"
        path="chat-camera/" />
    <cache-path
        name="gig_camera"
        path="gig-camera/" />
    <cache-path
        name="post_camera"
        path="post-camera/" />
    <cache-path
        name="reading_camera"
        path="reading-camera/" />
    <!-- Files opened from a chat in another app. -->
    <cache-path
        name="chat_files"
        path="chat-files/" />
    <!-- Mail enclosures opened in another app (MailEnclosureFiles). -->
    <cache-path
        name="mail_enclosures"
        path="mail-enclosures/" />
    <!-- Home documents, the emergency card and residency letters (HomeDocumentTemporaryFiles). -->
    <cache-path
        name="home_documents"
        path="home-document-files/" />
    <!-- Today's sky card and calendar invites, for the share sheet. -->
    <cache-path
        name="share"
        path="share/" />
</paths>
