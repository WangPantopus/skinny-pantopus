<?xml version="1.0" encoding="utf-8"?>
<!-- https://developer.android.com/guide/topics/data/autobackup#EnablingAutoBackup -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="private_home_task_recurrence_v1.xml" />
        <exclude domain="sharedpref" path="private_home_task_gig_v1.xml" />
        <exclude domain="sharedpref" path="private_home_relationship_v1.xml" />
        <exclude domain="sharedpref" path="private_home_creation_v1.xml" />
        <exclude domain="sharedpref" path="private_home_postal_v1.xml" />
        <exclude domain="sharedpref" path="private_home_residency_review_v1.xml" />
        <exclude domain="sharedpref" path="private_home_invitation_decision_v1.xml" />
        <exclude domain="sharedpref" path="private_pending_deep_link_v1.xml" />
        <exclude domain="sharedpref" path="pantopus_pending_deep_link.xml" />
        <exclude domain="sharedpref" path="secure_auth_tokens.xml" />
        <exclude domain="file" path="datastore/auth_tokens.preferences_pb" />
        <!-- Persistent login: device identity is per install (see backup_rules.xml). -->
        <exclude domain="sharedpref" path="device_identity.xml" />
        <exclude domain="sharedpref" path="app_lock_prefs_secure.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="private_home_task_recurrence_v1.xml" />
        <exclude domain="sharedpref" path="private_home_task_gig_v1.xml" />
        <exclude domain="sharedpref" path="private_home_relationship_v1.xml" />
        <exclude domain="sharedpref" path="private_home_creation_v1.xml" />
        <exclude domain="sharedpref" path="private_home_postal_v1.xml" />
        <exclude domain="sharedpref" path="private_home_residency_review_v1.xml" />
        <exclude domain="sharedpref" path="private_home_invitation_decision_v1.xml" />
        <exclude domain="sharedpref" path="private_pending_deep_link_v1.xml" />
        <exclude domain="sharedpref" path="pantopus_pending_deep_link.xml" />
        <exclude domain="sharedpref" path="secure_auth_tokens.xml" />
        <exclude domain="file" path="datastore/auth_tokens.preferences_pb" />
        <exclude domain="sharedpref" path="device_identity.xml" />
        <exclude domain="sharedpref" path="app_lock_prefs_secure.xml" />
    </device-transfer>
</data-extraction-rules>
