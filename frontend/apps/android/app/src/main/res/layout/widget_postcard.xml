<?xml version="1.0" encoding="utf-8"?>
<!-- The postcard widget: the enclosed picture, and who sent it and when over a soft shadow. RemoteViews-safe views only;
     colours from resources, never raw hex. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/postcardWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_today_sky_preview">

    <ImageView
        android:id="@+id/postcardWidgetPicture"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <TextView
        android:id="@+id/postcardWidgetLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:maxLines="3"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:shadowColor="@color/pantopus_widget_text_shadow"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:text="@string/widget_postcard_empty"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold" />
</FrameLayout>
