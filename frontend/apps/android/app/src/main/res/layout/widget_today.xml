<?xml version="1.0" encoding="utf-8"?>
<!-- "Today at your address" widget: the living sky (a bitmap TodayWidgetProvider draws with
     the app's painter) and the reading on top, kept left of the house like the Now card.
     RemoteViews-safe views only; colours from resources, never raw hex. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/todayWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/todayWidgetSky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_today_sky_preview" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="64"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/todayWidgetHeadline"
                style="@style/WidgetTodayText"
                android:ellipsize="end"
                android:maxLines="3"
                android:text="@string/widget_today_title"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/todayWidgetCaption"
                style="@style/WidgetTodayText"
                android:alpha="0.9"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/widget_today_open"
                android:textSize="12sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/todayWidgetTemp"
                style="@style/WidgetTodayText"
                android:fontFamily="sans-serif-light"
                android:maxLines="1"
                android:textSize="30sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/todayWidgetPlace"
                style="@style/WidgetTodayText"
                android:alpha="0.85"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="36" />
    </LinearLayout>
</FrameLayout>
