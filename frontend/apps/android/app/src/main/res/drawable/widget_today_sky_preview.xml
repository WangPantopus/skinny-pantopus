<?xml version="1.0" encoding="utf-8"?>
<!-- "Today at your address" in the widget picker and before the first update: a clear
     day sky (SkyPalette's day/clear colours) under the placeholder text. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="16dp" />
    <gradient
        android:angle="270"
        android:centerColor="@color/pantopus_widget_sky_mid"
        android:endColor="@color/pantopus_widget_sky_bottom"
        android:startColor="@color/pantopus_widget_sky_top" />
</shape>
