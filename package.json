{
  "name": "pantopus-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Pantopus — monorepo for the Pantopus platform. Node backend, Next.js web, native iOS (Swift), and native Android (Kotlin).",
  "workspaces": [
    "backend",
    "frontend/apps/web",
    "frontend/packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:backend": "cd backend && npm run dev",
    "dev:web": "cd frontend/apps/web && npm run dev",
    "ios:bootstrap": "cd frontend/apps/ios && make bootstrap",
    "ios:open": "cd frontend/apps/ios && make open",
    "android:assemble:debug": "cd frontend/apps/android && ./gradlew assembleDebug",
    "android:install:debug": "cd frontend/apps/android && ./gradlew installDebug",
    "build": "turbo run build",
    "build:web": "cd frontend/apps/web && npm run build",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:check": "node scripts/db/check-migrations.cjs"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "prettier": "^3.4.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "proxy-addr@<2.0.8": "^2.0.8",
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "engine.io@<6.6.10": "^6.6.10",
      "socket.io-parser@<4.2.7": "^4.2.7",
      "undici@>=7.0.0 <7.29.1": "^7.29.1",
      "fast-uri@>=3.0.0 <3.1.7": "^3.1.7",
      "form-data@>=4.0.0 <4.0.6": "^4.0.6",
      "fast-xml-builder@<1.1.7": "^1.1.7",
      "qs@<6.16.0": "^6.16.0",
      "postcss@>=8.0.0 <8.5.23": "^8.5.23",
      "nanoid@>=3.0.0 <3.3.18": "^3.3.18",
      "browserslist@>=4.0.0 <4.28.7": "^4.28.7",
      "source-map-js@<1.2.2": "^1.2.2",
      "fast-xml-parser@>=5.0.0 <5.7.0": "^5.7.0",
      "@babel/core@>=7.0.0 <7.29.6": "^7.29.6",
      "body-parser@>=2.0.0 <2.3.0": "^2.3.0",
      "handlebars@>=4.0.0 <4.7.10": "^4.7.10",
      "brace-expansion@>=1.0.0 <1.1.21": "^1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
      "brace-expansion@>=5.0.0 <5.0.12": "^5.0.12",
      "js-yaml@>=3.0.0 <3.15.2": "^3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "postcss-selector-parser@>=6.0.0 <6.1.3": "^6.1.3",
      "postcss-selector-parser@>=7.0.0 <7.1.6": "^7.1.6",
      "turbo@>=2.0.0 <2.9.14": "^2.9.14"
    }
  }
}
