  "tips": {
    "winter_ice": [
      "Freeze season. Protect outdoor faucets and exposed pipes, and keep de-icing supplies handy.",
      "Keep a flashlight, spare batteries, and a charged phone power bank easy to reach in case winter weather interrupts power.",
      "Check your heating system and replace its filter according to the manufacturer's instructions. Arrange service if it is not working properly."
    ],
    "spring_cleanup": [
      "Spring cleanup season: gutters, pressure washing, and yard cleanup are the top residential jobs right now.",
      "Check your own waste provider's yard-debris collection dates and accepted materials before setting branches or bags at the curb.",
      "Inspect gutters and downspouts from the ground for debris or visible damage. Arrange help for work that requires roof access."
    ],
    "early_summer": [
      "Early summer is the window for outdoor projects: decks, paint, and landscaping before the heat peaks.",
      "Inspect decks, fences, and exterior trim for loose fasteners or damage before starting outdoor projects.",
      "Check the local forecast and product instructions before exterior painting or staining; suitable temperatures and drying time matter."
    ],
    "summer_dry": [
      "Peak summer: water early in the morning, watch for local watering restrictions, and keep AC filters fresh.",
      "Check irrigation lines and outdoor faucets for leaks, and adjust watering to local restrictions and your plants' needs.",
      "Before traveling, arrange care for pets and plants and decide how mail and deliveries will be handled."
    ],
    "smoke_season": [
      "Wildfire smoke can reach far from any fire. Check the AQI on hazy days and run HVAC on recirculate with a good filter.",
      "Check local air-quality alerts before scheduling outdoor maintenance. Follow local guidance when smoke affects your area.",
      "Inspect door and window seals for gaps and check that replacement HVAC filters are compatible with your system."
    ],
    "fall_prep": [
      "Fall home care: clear fallen leaves from gutters and downspouts, and have the heating system checked before colder weather.",
      "Check weatherstripping around doors and windows for damage or gaps as the weather cools.",
      "Turn on your heating system before you need it regularly, so there is time to address maintenance or repair needs."
    ],
    "holiday_season": [
      "Package theft peaks in December. Consider coordinating with neighbors for delivery watching.",
      "Before holiday travel, arrange for mail and packages to be collected and leave a way for a trusted contact to reach you.",
      "Inspect seasonal decorations for damaged cords and follow the manufacturer's indoor or outdoor use and electrical load instructions."
    ]
  },
  "overlays": {
    "hurricane_season": {
      "label": "Hurricane Season",
      "tips": [
        "Atlantic hurricane season runs June 1 to November 30 and peaks in September. Know your evacuation zone, keep a week of water and medication, and photograph your home for insurance before a storm is named."
      ]
    },
    "tornado_season": {
      "label": "Tornado Season",
      "tips": [
        "Tornado season peaks in spring. Know your safe room \u2014 the lowest interior room with no windows \u2014 and keep weather alerts on overnight."
      ]
    },
    "monsoon_season": {
      "label": "Monsoon Season",
      "tips": [
        "The Southwest monsoon runs June 15 to September 30: flash floods and dust storms arrive fast. Never drive through a flooded wash, and clear roof drains before the first storms."
      ]
    },
    "heat_season": {
      "label": "Extreme Heat Season",
      "tips": [
        "Extreme heat is the deadliest weather in the United States. Check on older neighbors, keep AC filters fresh, and know the nearest cooling center."
      ]
    },
    "wildfire_season": {
      "label": "Wildfire Season",
      "tips": [
        "Wildfire season: keep the first five feet around the house free of dry vegetation, clear needles from the roof and gutters, and check the AQI on smoke days."
      ]
    },
    "winter_storm_season": {
      "label": "Winter Storm Season",
      "tips": [
        "Winter storm season: clear gutters before the rains, know where your water shutoff is, and keep a flashlight and a charged battery pack by the door."
      ]
    },
    "blizzard_season": {
      "label": "Blizzard Season",
      "tips": [
        "Blizzard season: insulate exposed pipes, keep the furnace filter fresh, and have sand or salt ready before the first storm."
      ]
    },
    "freeze_season": {
      "label": "Deep-Freeze Season",
      "tips": [
        "Deep-freeze season: heat tape on exposed lines, engine block heaters plugged in, and a carbon monoxide alarm tested."
      ]
    },
    "pollen_season": {
      "label": "Pollen Season",
      "tips": [
        "Pollen season: change HVAC filters monthly, keep windows closed on high-count mornings, and check the daily pollen forecast."
      ]
    }
  },
  "regional_tips": {
    "hawaii": {
      "hurricane_season": [
        "Central Pacific hurricane season runs June through November. Review local emergency guidance, prepare essential supplies, and secure loose outdoor items before a storm."
      ]
    }
  },
